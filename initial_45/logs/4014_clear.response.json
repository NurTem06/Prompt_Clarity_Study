          "annotations": [],
          "text": "import sys\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n\n    n, m = data[0], data[1]\n    starts = [0] * m\n    deadlines = [0] * m\n    remaining = [0] * m\n    exam_on = [-1] * (n + 1)\n\n    pos = 2\n    for i in range(m):\n        s, d, c = data[pos:pos + 3]\n        pos += 3\n        starts[i] = s\n        deadlines[i] = d\n        remaining[i] = c\n        exam_on[d] = i\n\n    schedule = [0] * n\n\n    for day in range(1, n + 1):\n        exam = exam_on[day]\n        if exam != -1:\n            if remaining[exam]:\n                print(-1)\n                return\n            schedule[day - 1] = m + 1\n            continue\n\n        best = -1\n        for i in range(m):\n            if remaining[i] and starts[i] <= day < deadlines[i]:\n                if best == -1 or deadlines[i] < deadlines[best]:\n                    best = i\n\n        if best != -1:\n            schedule[day - 1] = best + 1\n            remaining[best] -= 1\n\n    print(*schedule)\n\n\nif __name__ == \"__main__\":\n    main()",
