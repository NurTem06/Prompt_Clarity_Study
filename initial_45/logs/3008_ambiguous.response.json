          "text": "import sys\nfrom bisect import bisect_right\n\n\ndef find(parent, x):\n    while parent[x] != x:\n        parent[x] = parent[parent[x]]\n        x = parent[x]\n    return x\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    n, k = data[0], data[1]\n    a = data[2:2 + n]\n    b = data[2 + n:2 + 2 * n]\n    del data\n\n    order_a = sorted(range(n), key=a.__getitem__)\n    order_b = sorted(range(n), key=b.__getitem__)\n\n    pos_a = [0] * n\n    pos_b = [0] * n\n    for i, v in enumerate(order_a):\n        pos_a[v] = i\n    for i, v in enumerate(order_b):\n        pos_b[v] = i\n\n    values_a = [a[v] for v in order_a]\n    values_b = [b[v] for v in order_b]\n    limit_a = [bisect_right(values_a, x + k) for x in a]\n    limit_b = [bisect_right(values_b, x + k) for x in b]\n    del values_a, values_b\n\n    parent_a = list(range(n + 1))\n    parent_b = list(range(n + 1))\n    seen = bytearray(n)\n    finish = []\n\n    for root in range(n):\n        if seen[root]:\n            continue\n\n        seen[root] = 1\n        p = pos_a[root]\n        parent_a[p] = find(parent_a, p + 1)\n        p = pos_b[root]\n        parent_b[p] = find(parent_b, p + 1)\n        stack = [root]\n\n        while stack:\n            v = stack[-1]\n            p = find(parent_a, limit_a[v])\n            if p < n:\n                u = order_a[p]\n            else:\n                p = find(parent_b, limit_b[v])\n                if p == n:\n                    finish.append(stack.pop())\n                    continue\n                u = order_b[p]\n\n            seen[u] = 1\n            p = pos_a[u]\n            parent_a[p] = find(parent_a, p + 1)\n            p = pos_b[u]\n            parent_b[p] = find(parent_b, p + 1)\n            stack.append(u)\n\n    del parent_a, parent_b, pos_a, pos_b, limit_a, limit_b\n\n    seen = bytearray(n)\n    pointer_a = 0\n    pointer_b = 0\n    answer = 0\n\n    for root in reversed(finish):\n        if seen[root]:\n            continue\n\n        answer += 1\n        seen[root] = 1\n        stack = [root]\n\n        while stack:\n            v = stack.pop()\n            threshold = a[v] - k\n            while pointer_a < n:\n                u = order_a[pointer_a]\n                if seen[u]:\n                    pointer_a += 1\n                elif a[u] < threshold:\n                    seen[u] = 1\n                    stack.append(u)\n                    pointer_a += 1\n                else:\n                    break\n\n            threshold = b[v] - k\n            while pointer_b < n:\n                u = order_b[pointer_b]\n                if seen[u]:\n                    pointer_b += 1\n                elif b[u] < threshold:\n                    seen[u] = 1\n                    stack.append(u)\n                    pointer_b += 1\n                else:\n                    break\n\n    print(answer)\n\n\nif __name__ == \"__main__\":\n    main()\n",
          "type": "output_text",
          "logprobs": []
        }
