          "annotations": [],
          "text": "import sys\nfrom functools import lru_cache\n\n\ndef main():\n    s = sys.stdin.buffer.read().strip().decode()\n    if not s:\n        return\n\n    digits = tuple(map(int, s))\n    falling = False\n\n    for a, b in zip(digits, digits[1:]):\n        if b < a:\n            falling = True\n        elif b > a and falling:\n            print(-1)\n            return\n\n    length = len(digits)\n\n    @lru_cache(maxsize=None)\n    def count(pos, last, falling, tight):\n        if pos == length:\n            return 1\n\n        limit = digits[pos] if tight else 9\n        if falling:\n            limit = min(limit, last)\n\n        total = 0\n        for digit in range(limit + 1):\n            total += count(\n                pos + 1,\n                digit,\n                falling or digit < last,\n                tight and digit == digits[pos],\n            )\n        return total\n\n    print(count(0, 0, False, True) - 1)\n\n\nif __name__ == \"__main__\":\n    main()",
          "type": "output_text",
          "logprobs": []
        }
