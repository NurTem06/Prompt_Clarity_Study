          "annotations": [],
          "text": "import sys\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    n, k = data[0], data[1]\n    prefix = data[2:2 + k]\n\n    used = bytearray(n + 1)\n    stack = []\n    expected = 1\n\n    for x in prefix:\n        if stack and stack[-1] < x:\n            sys.stdout.write(\"-1\\n\")\n            return\n\n        used[x] = 1\n        stack.append(x)\n\n        while stack and stack[-1] == expected:\n            stack.pop()\n            expected += 1\n\n    answer = [str(x) for x in prefix]\n    stack.reverse()\n    stack.append(n + 1)\n\n    previous = 0\n    for boundary in stack:\n        for x in range(boundary - 1, previous, -1):\n            if not used[x]:\n                answer.append(str(x))\n        previous = boundary\n\n    sys.stdout.write(\" \".join(answer) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
