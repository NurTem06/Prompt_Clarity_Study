          "text": "import sys\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    n = data[0]\n    f = data[1:n + 1]\n\n    used = bytearray(n + 1)\n    empty = []\n    for i, value in enumerate(f):\n        if value:\n            used[value] = 1\n        else:\n            empty.append(i)\n\n    missing = [value for value in range(1, n + 1) if not used[value]]\n    bad = []\n\n    for i, value in zip(empty, missing):\n        f[i] = value\n        if value == i + 1:\n            bad.append(i)\n\n    if len(bad) == 1:\n        i = bad[0]\n        j = empty[0] if empty[0] != i else empty[1]\n        f[i], f[j] = f[j], f[i]\n    elif len(bad) > 1:\n        first = f[bad[0]]\n        for k in range(len(bad) - 1):\n            f[bad[k]] = f[bad[k + 1]]\n        f[bad[-1]] = first\n\n    sys.stdout.write(\" \".join(map(str, f)))\n\n\nif __name__ == \"__main__\":\n    main()\n",
