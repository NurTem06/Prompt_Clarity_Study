          "text": "import sys\nfrom math import gcd\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n\n    n = data[0]\n    segments = []\n    for k in range(1, 4 * n + 1, 4):\n        x0, y0, x1, y1 = data[k:k + 4]\n        if x0 > x1 or (x0 == x1 and y0 > y1):\n            x0, y0, x1, y1 = x1, y1, x0, y0\n        segments.append((\n            x0, y0, x1, y1,\n            x1 - x0, y1 - y0,\n            min(y0, y1), max(y0, y1)\n        ))\n    del data\n\n    points = set()\n    offset = 1 << 63\n\n    for i in range(n):\n        ax, ay, bx, by, rx, ry, low_y, high_y = segments[i]\n\n        for j in range(i):\n            cx, cy, dx, dy, sx, sy, other_low_y, other_high_y = segments[j]\n\n            if (bx < cx or dx < ax or\n                    high_y < other_low_y or other_high_y < low_y):\n                continue\n\n            qx = cx - ax\n            qy = cy - ay\n            denominator = rx * sy - ry * sx\n\n            if denominator == 0:\n                if qx * ry - qy * rx != 0:\n                    continue\n\n                if rx:\n                    left = max(ax, cx)\n                    right = min(bx, dx)\n                else:\n                    left = max(ay, cy)\n                    right = min(by, dy)\n\n                if left < right:\n                    print(-1)\n                    return\n                if left > right:\n                    continue\n\n                if ax > cx or (ax == cx and ay >= cy):\n                    px, py = ax, ay\n                else:\n                    px, py = cx, cy\n\n                points.add(\n                    ((px + offset) << 107) |\n                    ((py + offset) << 43) |\n                    1\n                )\n                continue\n\n            t = qx * sy - qy * sx\n            u = qx * ry - qy * rx\n\n            if denominator < 0:\n                denominator = -denominator\n                t = -t\n                u = -u\n\n            if t < 0 or t > denominator or u < 0 or u > denominator:\n                continue\n\n            px = ax * denominator + rx * t\n            py = ay * denominator + ry * t\n            common = gcd(gcd(px, py), denominator)\n\n            if common != 1:\n                px //= common\n                py //= common\n                denominator //= common\n\n            points.add(\n                ((px + offset) << 107) |\n                ((py + offset) << 43) |\n                denominator\n            )\n\n    print(len(points))\n\n\nif __name__ == \"__main__\":\n    main()\n",
