        {
          "annotations": [],
          "text": "import sys\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    n, q = data[0], data[1]\n\n    intervals = []\n    diff = [0] * (n + 2)\n    for i in range(2, 2 + 2 * q, 2):\n        l, r = data[i], data[i + 1]\n        intervals.append((l, r))\n        diff[l] += 1\n        diff[r + 1] -= 1\n\n    one = [0] * (n + 1)\n    two = [0] * (n + 1)\n    coverage = 0\n    total = 0\n    for x in range(1, n + 1):\n        coverage += diff[x]\n        total += coverage > 0\n        one[x] = one[x - 1] + (coverage == 1)\n        two[x] = two[x - 1] + (coverage == 2)\n\n    painters = sorted(\n        (one[r] - one[l - 1], l, r) for l, r in intervals\n    )\n\n    best_loss = total + 1\n    for i in range(q - 1):\n        unique_i, li, ri = painters[i]\n        if 2 * unique_i >= best_loss:\n            break\n\n        for j in range(i + 1, q):\n            unique_j, lj, rj = painters[j]\n            loss = unique_i + unique_j\n            if loss >= best_loss:\n                break\n\n            left = li if li > lj else lj\n            right = ri if ri < rj else rj\n            if left <= right:\n                loss += two[right] - two[left - 1]\n\n            if loss < best_loss:\n                best_loss = loss\n                if best_loss == 0:\n                    print(total)\n                    return\n\n    print(total - best_loss)\n\n\nif __name__ == \"__main__\":\n    main()\n",
          "type": "output_text",
          "logprobs": []
        }
      ],
