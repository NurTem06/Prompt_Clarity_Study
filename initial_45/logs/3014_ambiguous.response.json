          "text": "import sys\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n\n    n, m = data[0], data[1]\n    forward = []\n    backward = []\n\n    for i in range(m):\n        u = data[2 + 2 * i]\n        v = data[3 + 2 * i]\n        if u < v:\n            forward.append(i + 1)\n        else:\n            backward.append(i + 1)\n\n    removed = forward if len(forward) <= len(backward) else backward\n    sys.stdout.write(\"\\n\".join(map(str, [len(removed)] + removed)) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
