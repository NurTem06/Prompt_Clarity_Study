          "annotations": [],
          "text": "import sys\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n\n    d, n, m = data[:3]\n    min_x = [0] * (n + 1)\n    max_x = [0] * (n + 1)\n    min_y = [0] * (m + 1)\n    max_y = [0] * (m + 1)\n\n    end = 3 + 4 * d\n    for p in range(3, end, 4):\n        x1, y1, x2, y2 = data[p:p + 4]\n        if x1 > x2:\n            x1, x2 = x2, x1\n        if y1 > y2:\n            y1, y2 = y2, y1\n        data[p:p + 4] = x1, y1, x2, y2\n        min_x[x1] += 1\n        max_x[x2] += 1\n        min_y[y1] += 1\n        max_y[y2] += 1\n\n    for i in range(1, n + 1):\n        min_x[i] += min_x[i - 1]\n        max_x[i] += max_x[i - 1]\n\n    for i in range(1, m + 1):\n        min_y[i] += min_y[i - 1]\n        max_y[i] += max_y[i - 1]\n\n    left, right, top, bottom = data[end:end + 4]\n\n    for p in range(3, end, 4):\n        x1, y1, x2, y2 = data[p:p + 4]\n        horizontal = int(x1 != x2)\n        vertical = int(y1 != y2)\n\n        if min_x[x2 - 1] - horizontal != left:\n            continue\n        if d - max_x[x1] - horizontal != right:\n            continue\n        if min_y[y2 - 1] - vertical != top:\n            continue\n        if d - max_y[y1] - vertical != bottom:\n            continue\n\n        print((p - 3) // 4 + 1)\n        return\n\n    print(-1)\n\n\nif __name__ == \"__main__\":\n    main()\n",
          "type": "output_text",
          "logprobs": []
        }
