          "annotations": [],
          "text": "import sys\n\n\ndef main():\n    input = sys.stdin.buffer.readline\n    n, k = map(int, input().split())\n    main_courses = list(map(int, input().split()))\n\n    prerequisites = [[] for _ in range(n + 1)]\n    for course in range(1, n + 1):\n        prerequisites[course] = list(map(int, input().split()))[1:]\n\n    state = bytearray(n + 1)\n    order = []\n\n    for root in main_courses:\n        if state[root] == 2:\n            continue\n\n        stack = [root]\n        while stack:\n            course = stack.pop()\n\n            if course < 0:\n                course = -course\n                state[course] = 2\n                order.append(course)\n                continue\n\n            if state[course] == 2:\n                continue\n            if state[course] == 1:\n                sys.stdout.write(\"-1\\n\")\n                return\n\n            state[course] = 1\n            stack.append(-course)\n            stack.extend(prerequisites[course])\n\n    sys.stdout.write(str(len(order)) + \"\\n\")\n    sys.stdout.write(\" \".join(map(str, order)) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
