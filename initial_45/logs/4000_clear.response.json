          "annotations": [],
          "text": "import sys\n\n\ndef main():\n    data = iter(map(int, sys.stdin.buffer.read().split()))\n    n = next(data)\n    graph = [[] for _ in range(n)]\n    for _ in range(n - 1):\n        u = next(data) - 1\n        v = next(data) - 1\n        graph[u].append(v)\n        graph[v].append(u)\n\n    def bfs(start):\n        dist = [-1] * n\n        parent = [-1] * n\n        dist[start] = 0\n        queue = [start]\n        for u in queue:\n            for v in graph[u]:\n                if dist[v] == -1:\n                    dist[v] = dist[u] + 1\n                    parent[v] = u\n                    queue.append(v)\n        return queue[-1], dist, parent\n\n    a, _, _ = bfs(0)\n    b, distances, parent = bfs(a)\n    diameter = distances[b]\n\n    dist = [-1] * n\n    queue = []\n    u = b\n    while u != -1:\n        queue.append(u)\n        dist[u] = 0\n        u = parent[u]\n\n    interior = queue[1]\n    for u in queue:\n        for v in graph[u]:\n            if dist[v] == -1:\n                dist[v] = dist[u] + 1\n                queue.append(v)\n\n    c = queue[-1]\n    if dist[c] == 0:\n        c = interior\n\n    print(diameter + dist[c])\n    print(a + 1, b + 1, c + 1)\n\n\nif __name__ == \"__main__\":\n    main()\n",
          "type": "output_text",
          "logprobs": []
        }
