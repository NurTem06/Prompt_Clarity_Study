          "annotations": [],
          "text": "import sys\nfrom math import gcd\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n\n    n = data[0]\n    segments = []\n    for i in range(n):\n        k = 1 + 4 * i\n        ax, ay, bx, by = data[k:k + 4]\n        if (ax, ay) > (bx, by):\n            ax, ay, bx, by = bx, by, ax, ay\n        segments.append((\n            ax, ay, bx, by,\n            bx - ax, by - ay,\n            min(ay, by), max(ay, by)\n        ))\n\n    segments.sort()\n    points = set()\n    offset = 1 << 63\n\n    for i in range(n):\n        ax, ay, bx, by, rx, ry, ymin, ymax = segments[i]\n\n        for j in range(i + 1, n):\n            cx, cy, dx, dy, sx, sy, vmin, vmax = segments[j]\n\n            if cx > bx:\n                break\n            if ymax < vmin or vmax < ymin:\n                continue\n\n            qx = cx - ax\n            qy = cy - ay\n            denominator = rx * sy - ry * sx\n\n            if denominator == 0:\n                if qx * ry != qy * rx:\n                    continue\n\n                if (ax, ay) >= (cx, cy):\n                    low_x, low_y = ax, ay\n                else:\n                    low_x, low_y = cx, cy\n\n                if (bx, by) <= (dx, dy):\n                    high_x, high_y = bx, by\n                else:\n                    high_x, high_y = dx, dy\n\n                if (low_x, low_y) < (high_x, high_y):\n                    print(-1)\n                    return\n                if low_x == high_x and low_y == high_y:\n                    key = (\n                        ((low_x + offset) << 107)\n                        | ((low_y + offset) << 43)\n                        | 1\n                    )\n                    points.add(key)\n                continue\n\n            t = qx * sy - qy * sx\n            u = qx * ry - qy * rx\n\n            if denominator < 0:\n                denominator = -denominator\n                t = -t\n                u = -u\n\n            if not (0 <= t <= denominator and 0 <= u <= denominator):\n                continue\n\n            xnum = ax * denominator + rx * t\n            ynum = ay * denominator + ry * t\n            common = gcd(gcd(xnum, ynum), denominator)\n\n            xnum //= common\n            ynum //= common\n            denominator //= common\n\n            key = (\n                ((xnum + offset) << 107)\n                | ((ynum + offset) << 43)\n                | denominator\n            )\n            points.add(key)\n\n    print(len(points))\n\n\nif __name__ == \"__main__\":\n    main()",
          "type": "output_text",
          "logprobs": []
        }
