          "annotations": [],
          "text": "import sys\nimport heapq\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n\n    n, m = data[0], data[1]\n    releases = [[] for _ in range(n + 1)]\n    exam_day = [0] * (n + 1)\n    remaining = [0] * (m + 1)\n\n    pos = 2\n    for i in range(1, m + 1):\n        s, d, c = data[pos:pos + 3]\n        pos += 3\n        releases[s].append((d, i))\n        exam_day[d] = i\n        remaining[i] = c\n\n    heap = []\n    plan = []\n\n    for day in range(1, n + 1):\n        for exam in releases[day]:\n            heapq.heappush(heap, exam)\n\n        i = exam_day[day]\n        if i:\n            if remaining[i]:\n                print(-1)\n                return\n            plan.append(m + 1)\n        elif heap:\n            deadline, i = heapq.heappop(heap)\n            if deadline <= day:\n                print(-1)\n                return\n            plan.append(i)\n            remaining[i] -= 1\n            if remaining[i]:\n                heapq.heappush(heap, (deadline, i))\n        else:\n            plan.append(0)\n\n    if any(remaining):\n        print(-1)\n    else:\n        print(*plan)\n\n\nif __name__ == \"__main__\":\n    main()",
          "type": "output_text",
          "logprobs": []
        }
