      "content": [
        {
          "annotations": [],
          "text": "import sys\nimport math\nimport heapq\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n\n    n = data[0]\n    lamps = sorted(tuple(data[i:i + 3]) for i in range(1, 3 * n + 1, 3))\n    total = sum(p[2] for p in lamps)\n\n    if total % 2:\n        print(\"IMPOSSIBLE\")\n        return\n    if total == 0:\n        print(\"0\")\n        return\n\n    size = 1 << n\n    target = total // 2\n    sums = [0] * size\n    balanced = bytearray(size)\n    active = [False] * n\n\n    for mask in range(1, size):\n        bit = mask & -mask\n        i = bit.bit_length() - 1\n        sums[mask] = sums[mask ^ bit] + lamps[i][2]\n        if sums[mask] == target:\n            balanced[mask] = 1\n            active[i] = True\n\n    if not any(active):\n        print(\"IMPOSSIBLE\")\n        return\n\n    points = sorted({\n        (x + dx, y + dy)\n        for x, y, _ in lamps\n        for dx in (-1, 1)\n        for dy in (-1, 1)\n    })\n    index = {p: i for i, p in enumerate(points)}\n    count = len(points)\n    graph = [[] for _ in points]\n\n    for a in range(count):\n        ax, ay = points[a]\n        for b in range(a + 1, count):\n            bx, by = points[b]\n            dx = bx - ax\n            dy = by - ay\n            blocked = False\n\n            for x, y, _ in lamps:\n                lo = 0.0\n                hi = 1.0\n\n                if dx == 0:\n                    if not x - 1 < ax < x + 1:\n                        continue\n                else:\n                    t1 = (x - 1 - ax) / dx\n                    t2 = (x + 1 - ax) / dx\n                    if t1 > t2:\n                        t1, t2 = t2, t1\n                    lo = max(lo, t1)\n                    hi = min(hi, t2)\n\n                if dy == 0:\n                    if not y - 1 < ay < y + 1:\n                        continue\n                else:\n                    t1 = (y - 1 - ay) / dy\n                    t2 = (y + 1 - ay) / dy\n                    if t1 > t2:\n                        t1, t2 = t2, t1\n                    lo = max(lo, t1)\n                    hi = min(hi, t2)\n\n                if lo < hi - 1e-12:\n                    blocked = True\n                    break\n\n            if blocked:\n                continue\n\n            crossing = 0\n            if dy:\n                for k, (x, y, _) in enumerate(lamps):\n                    if (ay <= y < by) or (by <= y < ay):\n                        cross = (ax - x) * dy + (y - ay) * dx\n                        if (cross < 0) if dy > 0 else (cross > 0):\n                            crossing |= 1 << k\n\n            length = math.hypot(dx, dy)\n            shifted = crossing << 6\n            graph[a].append((b, length, shifted))\n            graph[b].append((a, length, shifted))\n\n    best = math.inf\n    state_count = size << 6\n    heappush = heapq.heappush\n    heappop = heapq.heappop\n\n    for lamp_id in range(n - 1, -1, -1):\n        if not active[lamp_id]:\n            continue\n\n        x, y, _ = lamps[lamp_id]\n        start = index[(x - 1, y - 1)]\n        sx, sy = points[start]\n        heuristic = [\n            math.hypot(px - sx, py - sy) for px, py in points\n        ]\n\n        edges = [[] for _ in points]\n        for v in range(start, count):\n            edges[v] = [\n                (w, length, toggle)\n                for w, length, toggle in graph[v]\n                if w >= start\n            ]\n\n        dist = [math.inf] * state_count\n        dist[start] = 0.0\n        heap = [(0.0, 0.0, start)]\n        first_bit = 1 << lamp_id\n        lower_bits = (first_bit << 1) - 1\n\n        while heap:\n            estimate, distance, state = heappop(heap)\n            if estimate >= best:\n                break\n            if distance != dist[state]:\n                continue\n\n            v = state & 63\n            mask = state >> 6\n            if (\n                v == start\n                and balanced[mask]\n                and mask & lower_bits == first_bit\n            ):\n                best = distance\n                break\n\n            base = state ^ v\n            for w, length, toggle in edges[v]:\n                nd = distance + length\n                ne = nd + heuristic[w]\n                if ne >= best:\n                    continue\n                ns = (base ^ toggle) | w\n                if nd < dist[ns]:\n                    dist[ns] = nd\n                    heappush(heap, (ne, nd, ns))\n\n    if math.isinf(best):\n        print(\"IMPOSSIBLE\")\n    else:\n        print(f\"{best:.12f}\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
