          "annotations": [],
          "text": "import sys\n\n\ndef main():\n    data = sys.stdin.buffer\n    line = data.readline()\n    if not line:\n        return\n    n = int(line)\n    adjacency = [0] * n\n\n    for u in range(n):\n        for v in map(int, data.readline().split()):\n            adjacency[u] |= 1 << v\n            adjacency[v] |= 1 << u\n\n    size = 1 << n\n    independent = bytearray(size)\n    independent[0] = 1\n\n    for mask in range(1, size):\n        bit = mask & -mask\n        rest = mask ^ bit\n        vertex = bit.bit_length() - 1\n        independent[mask] = (\n            independent[rest] and not (adjacency[vertex] & rest)\n        )\n\n    dp = [0] * size\n    for mask in range(1, size):\n        if independent[mask]:\n            dp[mask] = 1\n            continue\n\n        bit = mask & -mask\n        rest = mask ^ bit\n        best = dp[rest] + 1\n        subset = rest\n\n        while subset:\n            color_class = subset | bit\n            if independent[color_class]:\n                candidate = dp[mask ^ color_class] + 1\n                if candidate < best:\n                    best = candidate\n                    if best == 2:\n                        break\n            subset = (subset - 1) & rest\n\n        dp[mask] = best\n\n    print(dp[-1])\n\n\nif __name__ == \"__main__\":\n    main()",
          "type": "output_text",
          "logprobs": []
        }
