          "text": "import sys\n\n\ndef main():\n    stream = sys.stdin.buffer\n    n = int(stream.readline())\n    adjacency = [0] * n\n\n    for u in range(n):\n        for token in stream.readline().split():\n            v = int(token)\n            adjacency[u] |= 1 << v\n            adjacency[v] |= 1 << u\n\n    size = 1 << n\n    independent = [False] * size\n    independent[0] = True\n\n    for mask in range(1, size):\n        bit = mask & -mask\n        vertex = bit.bit_length() - 1\n        rest = mask ^ bit\n        independent[mask] = independent[rest] and not (adjacency[vertex] & rest)\n\n    dp = [0] * size\n    for mask in range(1, size):\n        if independent[mask]:\n            dp[mask] = 1\n            continue\n\n        anchor = mask & -mask\n        rest = mask ^ anchor\n        best = n\n        sub = rest\n\n        while True:\n            group = sub | anchor\n            if independent[group]:\n                best = min(best, 1 + dp[mask ^ group])\n                if best == 2:\n                    break\n            if sub == 0:\n                break\n            sub = (sub - 1) & rest\n\n        dp[mask] = best\n\n    print(dp[-1])\n\n\nif __name__ == \"__main__\":\n    main()\n",
          "type": "output_text",
          "logprobs": []
        }
