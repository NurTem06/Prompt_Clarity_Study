          "text": "import sys\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    n = int(data[0])\n    s = data[1]\n    total_gold = s.count(b'G')\n\n    left = 0\n    silver_count = 0\n    best = 0\n\n    for right in range(n):\n        if s[right] == 83:\n            silver_count += 1\n\n        while silver_count > 1:\n            if s[left] == 83:\n                silver_count -= 1\n            left += 1\n\n        best = max(best, right - left + 1)\n\n    print(min(best, total_gold))\n\nif __name__ == \"__main__\":\n    main()",
