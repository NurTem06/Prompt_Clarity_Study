          "annotations": [],
          "text": "import sys\n\n\ndef solve():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    out = []\n\n    for i in range(1, len(data), 3):\n        a, b, c = data[i:i + 3]\n\n        r = c % a\n        C = c - r if r <= a - r else c + a - r\n        best = b - a + abs(C - c)\n        answer = (a, a, C)\n\n        r = c % b\n        C = c - r if r <= b - r else c + b - r\n        cost = a - 1 + abs(C - c)\n        if cost < best:\n            best = cost\n            answer = (1, b, C)\n\n        for A in range(max(1, a - best), a + best + 1):\n            da = abs(A - a)\n            if da >= best:\n                continue\n\n            remaining = best - da - 1\n            low = max(1, (b - remaining + A - 1) // A)\n            high = (b + remaining) // A\n\n            for B in range(low * A, high * A + 1, A):\n                partial = da + abs(B - b)\n                if partial >= best:\n                    continue\n\n                if B > c:\n                    C = B\n                    distance = B - c\n                else:\n                    r = c % B\n                    if r <= B - r:\n                        C = c - r\n                        distance = r\n                    else:\n                        C = c + B - r\n                        distance = B - r\n\n                cost = partial + distance\n                if cost < best:\n                    best = cost\n                    answer = (A, B, C)\n\n            if best == 0:\n                break\n\n        out.append(str(best))\n        out.append(\"{} {} {}\".format(*answer))\n\n    sys.stdout.write(\"\\n\".join(out))\n\n\nif __name__ == \"__main__\":\n    solve()\n",
          "type": "output_text",
          "logprobs": []
        }
