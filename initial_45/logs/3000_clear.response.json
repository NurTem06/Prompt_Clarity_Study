          "text": "import sys\n\ndef main():\n    tokens = sys.stdin.buffer.read().split()\n    mod = 1_000_000_007\n    stack = []\n    value = 0\n    multiply = False\n\n    for token in tokens[1:]:\n        if token == b'(':\n            stack.append(value)\n            multiply = not multiply\n            value = 1 if multiply else 0\n        elif token == b')':\n            parent = stack.pop()\n            multiply = not multiply\n            if multiply:\n                value = parent * value % mod\n            else:\n                value = (parent + value) % mod\n        else:\n            number = int(token)\n            if multiply:\n                value = value * number % mod\n            else:\n                value = (value + number) % mod\n\n    print(value)\n\nif __name__ == \"__main__\":\n    main()\n",
