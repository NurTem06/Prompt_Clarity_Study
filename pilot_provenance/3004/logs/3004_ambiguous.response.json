          "text": "import sys\nfrom bisect import bisect_left\n\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    if not data:\n        return\n\n    n = int(data[0])\n    groups = {}\n    offers = []\n    endpoints = {0, 10000}\n\n    pos = 1\n    for _ in range(n):\n        color = data[pos]\n        a = int(data[pos + 1])\n        b = int(data[pos + 2])\n        pos += 3\n        if color not in groups:\n            groups[color] = []\n        groups[color].append((a, b))\n        offers.append((a, b, color))\n        endpoints.add(b)\n\n    offers.sort()\n    covered = 0\n    index = 0\n    lower = 0\n    used_colors = set()\n\n    while covered < 10000:\n        farthest = covered\n        chosen_color = None\n        while index < n and offers[index][0] <= covered + 1:\n            _, b, color = offers[index]\n            if b > farthest:\n                farthest = b\n                chosen_color = color\n            index += 1\n        if farthest == covered:\n            print(\"IMPOSSIBLE\")\n            return\n        covered = farthest\n        lower += 1\n        used_colors.add(chosen_color)\n\n    if len(used_colors) <= 3:\n        print(lower)\n        return\n\n    points = sorted(endpoints)\n    target = len(points) - 1\n    endpoint_index = {value: i for i, value in enumerate(points)}\n\n    rows = []\n    flags = []\n    counts = []\n\n    for intervals in groups.values():\n        intervals.sort()\n        useful = []\n        farthest = 0\n        for a, b in intervals:\n            if b > farthest:\n                useful.append((a, b))\n                farthest = b\n\n        flag = 0\n        if intervals[0][0] == 1:\n            flag |= 1\n        if farthest == 10000:\n            flag |= 2\n\n        row = []\n        j = 0\n        reach = 0\n        for p, value in enumerate(points):\n            while j < len(useful) and useful[j][0] <= value + 1:\n                reach = endpoint_index[useful[j][1]]\n                j += 1\n            row.append(max(p, reach))\n\n        rows.append(row)\n        flags.append(flag)\n        counts.append(len(useful))\n\n    k = len(rows)\n    best = n + 1\n\n    for i in range(k):\n        if flags[i] != 3 or counts[i] < lower:\n            continue\n        row = rows[i]\n        p = 0\n        steps = 0\n        while p < target and steps < best:\n            q = row[p]\n            if q == p:\n                break\n            p = q\n            steps += 1\n        if p == target and steps < best:\n            best = steps\n            if best == lower:\n                print(best)\n                return\n\n    for i in range(k):\n        a = rows[i]\n        for j in range(i + 1, k):\n            if (flags[i] | flags[j]) != 3:\n                continue\n            if counts[i] + counts[j] < lower:\n                continue\n            b = rows[j]\n            p = 0\n            steps = 0\n            while p < target and steps < best:\n                q = a[p]\n                if b[p] > q:\n                    q = b[p]\n                if q == p:\n                    break\n                p = q\n                steps += 1\n            if p == target and steps < best:\n                best = steps\n                if best == lower:\n                    print(best)\n                    return\n\n    for i in range(k - 2):\n        a = rows[i]\n        fi = flags[i]\n        ni = counts[i]\n        for j in range(i + 1, k - 1):\n            b = rows[j]\n            pair_flags = fi | flags[j]\n            pair_count = ni + counts[j]\n            first = max(a[0], b[0])\n\n            for h in range(j + 1, k):\n                if (pair_flags | flags[h]) != 3:\n                    continue\n                if pair_count + counts[h] < lower:\n                    continue\n\n                c = rows[h]\n                p = first\n                if c[0] > p:\n                    p = c[0]\n                steps = 1\n\n                while p < target and steps < best:\n                    q = a[p]\n                    if b[p] > q:\n                        q = b[p]\n                    if c[p] > q:\n                        q = c[p]\n                    if q == p:\n                        break\n                    p = q\n                    steps += 1\n\n                if p == target and steps < best:\n                    best = steps\n                    if best == lower:\n                        print(best)\n                        return\n\n    print(best if best <= n else \"IMPOSSIBLE\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
